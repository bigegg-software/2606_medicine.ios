{
  "expo": {
    "name": "智荟康",
    "slug": "medicine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bigegg.medicine",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄病例照片并进行识别",
        "NSPhotoLibraryUsageDescription": "用于从相册选择病例照片并进行识别"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "用于拍摄病例照片并进行识别",
          "photosPermission": "用于从相册选择病例照片并进行识别"
        }
      ]
    ],
    "android": {
      "package": "com.bigegg.medicine",
      "adaptiveIcon": {
        "backgroundColor": "#C45C4B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}