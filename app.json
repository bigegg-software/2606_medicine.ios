{
  "expo": {
    "name": "莱益晟",
    "slug": "medicine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bigegg.wisdomHealth",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄病例照片并进行识别",
        "NSPhotoLibraryUsageDescription": "用于从相册选择病例照片并进行识别",
        "NSLocalNetworkUsageDescription": "用于连接本地 AI 开发服务器进行健康对话",
        "NSMicrophoneUsageDescription": "需要麦克风权限以进行语音识别",
        "NSSpeechRecognitionUsageDescription": "需要语音识别权限以将语音转换为文字",
        "NSHealthShareUsageDescription": "用于同步 Apple 健康数据到您的健康档案",
        "NSHealthUpdateUsageDescription": "用于同步 Apple 健康数据到您的健康档案",
        "NSBluetoothAlwaysUsageDescription": "用于连接 Polar H10 等蓝牙心率设备，进行运动心率与 ECG 监测",
        "NSBluetoothPeripheralUsageDescription": "用于连接 Polar H10 等蓝牙心率设备，进行运动心率与 ECG 监测",
        "NSBluetoothUsageDescription": "用于连接 Polar H10 等蓝牙心率设备，进行运动心率与 ECG 监测",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "bluetooth-central"
        ]
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "用于拍摄病例照片并进行识别",
          "photosPermission": "用于从相册选择病例照片并进行识别"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "用于拍摄病例照片并进行识别"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "用于从相册选择病例照片并进行识别"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "需要麦克风权限以进行语音识别"
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-video",
      "expo-font",
      "@lottiefiles/dotlottie-react-native/plugin"
    ],
    "android": {
      "package": "com.bigegg.medicine",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#C45C4B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}